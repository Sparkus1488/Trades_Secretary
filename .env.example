# Local development only. Keep real secrets in your deployment secret manager. Set NODE_ENV=production only behind HTTPS.
PORT=4242
SITEPIX_DATA_DIR=./data
SITEPIX_BASE_URL=http://localhost:4242
SITEPIX_DEMO_BUSINESS_NAME=our construction team
NODE_ENV=development
TRUST_PROXY=0

# Required in production to keep registration limited to invited private-beta testers.
# Generate a long random value and share it only with invited testers.
SITEPIX_BETA_INVITE_CODE=

# AI marketing drafts (not auto-publishing)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Stripe test mode first; create monthly recurring Price IDs in the Stripe Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_MEASURE_BID=

# Twilio. Configure exact public HTTPS webhook URL in Twilio Console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_INCOMING_WEBHOOK_URL=
TWILIO_RECORDING_CALLBACK_URL=
TWILIO_VOICE_TURN_WEBHOOK_URL=
TWILIO_HANDOFF_WEBHOOK_URL=
SITEPIX_HUMAN_HANDOFF_NUMBER=
# Optional single-workspace fallback, or JSON object mapping each Twilio To number to organization ID.
TWILIO_ORGANIZATION_ID=
TWILIO_NUMBER_ORG_MAP={}

# Planned production adapters (not active in this release; do not assume these variables switch storage automatically).
DATABASE_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Facebook Page text publishing (requires a Page access token with the required approved permissions).
# Configure tokens only in your secret manager; never commit a real token.
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=

# Supplier pricing: Lowe's requires approved partner access; never scrape retailer websites.
LOWES_CLIENT_ID=
LOWES_ACCESS_TOKEN=
LOWES_API_BASE_URL=https://apis-b2b.lowes.com/lowesx-marketplace-gateway

# Optional route calculation for travel estimates (enable Routes API and restrict the key).
GOOGLE_MAPS_API_KEY=
